<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laravel handle root & SPA (spa.blade.php + site settings)
    DirectoryIndex index.php

    # HTTPS (Hostinger / proxy)
    RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
    RewriteCond %{HTTPS} =on
    RewriteRule ^ - [E=HTTPS:on]

    # Authorization header (Sanctum Bearer token)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # File & folder yang ada (assets Vue, favicon, storage, dll.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Semua request dinamis → Laravel (SPA, my-panel, api, dll.)
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
